# Copy to .env and fill in. Never commit .env — it holds real keys.
#
# Backend: self-hosted Supabase at https://supabase.schedulingpilot.com

# ---- Browser ----
# Vite inlines every VITE_* var into the client bundle, so only public values
# belong here. The publishable/anon key is public by design; it is the
# service-role key that must never appear with a VITE_ prefix.
VITE_SUPABASE_URL="https://supabase.example.com"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---- Server (SSR, server functions) ----
# Same two values, read from process.env instead of import.meta.env.
SUPABASE_URL="https://supabase.example.com"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---- Server only, never exposed to the browser ----
# Bypasses row-level security. Required by
# src/integrations/supabase/client.server.ts (admin client).
# Self-hosted: Studio > Settings > API, or SERVICE_ROLE_KEY in your stack's .env.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---- Web Push: notifications that arrive with the app closed ----
# Without these the app still works and still pops notifications up while it is
# open — it just cannot reach a phone that is locked or an app that is shut.
#
# Make a pair once with `bun run vapid:keys` and keep them. Changing them
# unsubscribes every device that has already said yes, and each has to be asked
# again. The public half is inlined into the browser bundle by design: it is
# the value the browser subscribes with.
#
# Delivery also needs SUPABASE_SERVICE_ROLE_KEY above — the queue the dispatcher
# reads is closed to everything else.
VITE_VAPID_PUBLIC_KEY="<87-char public key from bun run vapid:keys>"
VAPID_PUBLIC_KEY="<the same public key again>"
VAPID_PRIVATE_KEY="<43-char private key from the same run — server only>"
# Who a push service should complain to about this app.
VAPID_SUBJECT="mailto:support@schedulingpilot.com"

# ---- Lock-screen push for the Android and iOS apps (server only) ----
# Never VITE_*: those are compiled into the app bundle. Each platform is
# optional; without its variables that app shows alerts only while open.
# Full setup: docs/mobile/push-notifications.md
# Android: Firebase service-account JSON, pasted whole or base64-encoded.
FCM_SERVICE_ACCOUNT=""
# iOS: Apple Push key (.p8) from developer.apple.com > Keys.
APNS_KEY_ID=""
APNS_TEAM_ID=""
# The .p8 file contents (BEGIN/END lines included), or base64 of the file.
APNS_PRIVATE_KEY=""
# Optional: APNS_BUNDLE_ID (default com.schedulingpilot.app),
# APNS_ENV=production|sandbox (which Apple server is tried first; default production).

# A stack that emits ANON_KEY rather than a publishable key can use these names
# instead; the client accepts either.
# VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."
# SUPABASE_ANON_KEY="eyJhbGciOi..."
