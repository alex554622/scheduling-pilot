# Copy to .env and fill in. Never commit .env — it holds real keys.
#
# Backend: self-hosted Supabase at https://supabase.schedulingpilot.com

# ---- Browser ----
# Vite inlines every VITE_* var into the client bundle, so only public values
# belong here. The publishable/anon key is public by design; it is the
# service-role key that must never appear with a VITE_ prefix.
VITE_SUPABASE_URL="https://supabase.example.com"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---- Server (SSR, server functions) ----
# Same two values, read from process.env instead of import.meta.env.
SUPABASE_URL="https://supabase.example.com"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---- Server only, never exposed to the browser ----
# Bypasses row-level security. Required by
# src/integrations/supabase/client.server.ts (admin client).
# Self-hosted: Studio > Settings > API, or SERVICE_ROLE_KEY in your stack's .env.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"

# A stack that emits ANON_KEY rather than a publishable key can use these names
# instead; the client accepts either.
# VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."
# SUPABASE_ANON_KEY="eyJhbGciOi..."
