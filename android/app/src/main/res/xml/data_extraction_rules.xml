<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nothing from this app goes to a cloud backup or to a new phone
  during device transfer. The only thing stored on the device is the signed-in
  session, and that should be created fresh by signing in on the new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
